# Sao chép thành .env (đã được .gitignore). Không commit mật khẩu thật.
PORT=3000
# Dashboard: mặc định chỉ nghe 127.0.0.1. Muốn truy cập từ máy khác: đặt token rồi mở host.
DASHBOARD_TOKEN=doi-thanh-mat-khau-dai-ngau-nhien
DASHBOARD_HOST=0.0.0.0
# Mật khẩu bot theo id (bot "bot-1" -> BOT_PASSWORD_BOT_1), hoặc chung cho mọi bot:
BOT_PASSWORD_BOT_1=
BOT_PASSWORD=
# Telegram (tuỳ chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Thư mục log runtime (mặc định logs/ cạnh config.json)
# ANTER_LOG_DIR=
# Bật log các lỗi bị nuốt để debug
ANTER_DEBUG=0
# Tự cập nhật qua load.js: 0 = tắt. GH_BRANCH nhận branch/tag/SHA để ghim phiên bản.
ANTER_AUTO_UPDATE=1
# GH_BRANCH=v1.0.0
# AI phân tích lỗi (Gemini). Lấy khoá tại https://aistudio.google.com (free tier không cần bật billing). KHÔNG commit khoá thật.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_DIAGNOSE=0   # 0 = tắt hẳn
